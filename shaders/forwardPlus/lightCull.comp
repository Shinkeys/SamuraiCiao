    vec3 center;
    float radius;
};

// SHARED DATA
shared float minDepth;
shared float maxDepth;
shared int globalLightIndex;
void CullLights(int tileIndex)
{
    int localLightIndices[maxLights];
    ViewFrustum frustum = viewFrustumsBuffer[tileIndex];
    int localCounter = 0;
    // To prevent data races
    int lightsLocalList[maxLights];

    for(int i = 0; i < lightsCounter; ++i)
    {
        if(CheckIfLightIsInside(i, frustum))
        {
            if(localCounter < maxLights)
                lightsLocalList[localCounter++] = i;

        }
    }


    int offset = atomicAdd(globalLightIndex, localCounter);
    for(int i = 0; i < localCounter; ++i)
    {
        lightsGlobalIndList[offset + i] = lightsLocalList[i];
    }
}


