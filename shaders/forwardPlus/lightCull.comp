#version 460 core
#extension NV_shader_atomic_float : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct LightDesc
{
    vec3 position;
    float radius;
};

uniform sampler2D depthTexture;

const int maxLights = 512;
uniform int lightsCounter;
layout(std430, binding = 1) buffer lightsBuffer
{
    LightDesc lights[];
};


struct ViewFrustum
{
    vec4 normal[4];
    // std430 packs it like 4*4 = 16 so no padding needed.
    float distToPlane[4];
};
layout(std430, binding = 2) buffer frustumBuffer
{
    ViewFrustum viewFrustumsBuffer[16];
};

layout(std430, binding = 3) buffer lightsGlobalIndBuffer
{
    int lightsGlobalIndList[];
};

bool CheckIfLightIsInside(in int lightIndex, in ViewFrustum tileFrust)
